# Database
DATABASE_URL=postgresql://proximity:proximity_dev@localhost:5432/proximity_mvp

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# S3-compatible object storage (MinIO for local dev)
S3_BUCKET=proximity-photos
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# Providers (stubbed for MVP — logs to console)
OTP_PROVIDER=console
PUSH_PROVIDER=console

# Server
PORT=3000
NODE_ENV=development
